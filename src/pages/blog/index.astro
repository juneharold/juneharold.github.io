---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout
  title="Blog — Juneha Hwang"
  description="Thoughts on deep learning, mathematics, and software development."
>
  <!-- Nav -->
  <nav
    class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-12 py-5 bg-bg/80 backdrop-blur-md border-b border-border/50"
  >
    <a
      href="/"
      class="font-mono text-xs tracking-widest text-text-muted hover:text-accent transition-colors"
    >
      JH
    </a>
    <div class="flex gap-8">
      <a
        href="/#about"
        class="font-mono text-xs tracking-wider text-text-muted hover:text-text transition-colors"
        >About</a
      >
      <a
        href="/#projects"
        class="font-mono text-xs tracking-wider text-text-muted hover:text-text transition-colors"
        >Projects</a
      >
      <a
        href="/blog"
        class="font-mono text-xs tracking-wider text-text hover:text-accent transition-colors"
        >Blog</a
      >
      <a
        href="/Resume.pdf"
        target="_blank"
        class="font-mono text-xs tracking-wider text-text-muted hover:text-text transition-colors"
        >CV</a
      >
    </div>
  </nav>

  <!-- Blog listing -->
  <section class="min-h-screen px-6 md:px-12 lg:px-24 pt-32 pb-24">
    <div class="max-w-4xl">
      <div class="section-label mb-6 animate-slide-right">Blog</div>
      <h1
        class="font-display text-4xl md:text-6xl font-bold tracking-tight mb-6 animate-on-scroll"
      >
        Writing<span class="text-accent">.</span>
      </h1>
      <p
        class="text-lg text-text-muted leading-relaxed max-w-2xl mb-20 animate-on-scroll stagger-1"
      >
        Thoughts on deep learning, mathematics, software development, and
        occasionally football.
      </p>

      <div class="space-y-0">
        {
          sortedPosts.map((post, i) => (
            <a
              href={`/blog/${post.id}`}
              class:list={[
                "group block py-8 border-b border-border hover:border-accent transition-colors animate-on-scroll",
                i === 0 && "border-t",
              ]}
            >
              <div class="grid md:grid-cols-[1fr_auto] gap-4 items-start">
                <div>
                  <h2 class="font-display text-xl md:text-2xl font-semibold group-hover:text-accent transition-colors mb-2">
                    {post.data.title}
                  </h2>
                  <p class="text-sm text-text-muted leading-relaxed max-w-xl">
                    {post.data.excerpt}
                  </p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-3">
                      {post.data.tags.map((tag) => (
                        <span class="font-mono text-[0.65rem] text-text-muted border border-border px-2 py-1">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <span class="font-mono text-xs text-text-muted tracking-wider whitespace-nowrap">
                  {formatDate(post.data.date)}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
