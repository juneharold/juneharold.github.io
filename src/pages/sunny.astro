  /* ═══ GALLERY ═══ */
  .masonry {
    columns: 2; column-gap: 0.75rem;
  }
  @media (min-width: 640px)  { .masonry { columns: 3; column-gap: 1rem; } }
  @media (min-width: 1024px) { .masonry { columns: 4; } }

  .polaroid {
    break-inside: avoid;
    display: block; width: 100%;
    margin-bottom: 0.75rem;
    background: #fff;
    padding: 6px 6px 22px;
    border: none; cursor: pointer;
    border-radius: 2px;
    box-shadow:
      0 1px 3px rgba(139,107,115,0.08),
      0 4px 12px rgba(139,107,115,0.06);
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.35s cubic-bezier(.22,1,.36,1),
                box-shadow 0.35s ease;
    position: relative;
  }
  .polaroid img {
    width: 100%; height: auto; display: block;
    border-radius: 1px;
    background: #f0e8e5;
  }
  .polaroid:hover, .polaroid:focus-visible {
    transform: rotate(0deg) scale(1.04) translateY(-4px);
    box-shadow:
      0 8px 28px rgba(183,110,121,0.18),
      0 2px 8px rgba(183,110,121,0.1);
