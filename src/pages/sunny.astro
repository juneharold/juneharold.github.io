    outline: none;
  }
  @media (min-width: 640px) {
    .polaroid { padding: 8px 8px 28px; margin-bottom: 1rem; }
  }

  /* ═══ LIGHTBOX ═══ */
  .lb {
    position: fixed; inset: 0; z-index: 9990;
    background: rgba(30,15,18,0.92);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .lb.open { opacity: 1; pointer-events: auto; }
  .lb-img {
    max-width: 92vw; max-height: 88vh;
    object-fit: contain; border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    transition: opacity 0.25s ease;
  }
  .lb-close {
    position: absolute; top: 1rem; right: 1rem;
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(255,255,255,0.12); border: none;
    color: #fff; font-size: 1.4rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .lb-close:hover { background: rgba(255,255,255,0.25); }
  .lb-arr {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255,255,255,0.1); border: none;
    color: #fff; font-size: 1.8rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .lb-arr:hover { background: rgba(255,255,255,0.22); }
  .lb-prev { left: 0.75rem; }
  .lb-next { right: 0.75rem; }
  .lb-count {
    position: absolute; bottom: 1rem; left: 50%; transform: translateX(-50%);
    color: rgba(255,255,255,0.5); font-size: 0.8rem;
  }
  @media (max-width: 639px) {
    .lb-arr { display: none; }
  }

  /* ═══ GAME ═══ */
  .game-wrap {
    position: relative;
    max-width: 480px; margin: 0 auto;
    border-radius: 16px; overflow: hidden;
    box-shadow: 0 4px 24px rgba(183,110,121,0.12);
    background: linear-gradient(180deg, #FFF5F7, #FFECD2);
  }
  #gc {
    display: block; width: 100%; height: 420px;
    touch-action: none;
  }
  .game-overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(255,248,245,0.85);
    backdrop-filter: blur(4px);
    text-align: center; padding: 2rem;
    transition: opacity 0.3s;
  }
  .game-overlay.hide { opacity: 0; pointer-events: none; }
  .g-icon { font-size: 3rem; margin-bottom: 0.5rem; }
  .g-label {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.2rem; font-weight: 600; color: var(--s-text);
  }
  .g-sub { font-size: 0.8rem; color: var(--s-muted); margin: 0.3rem 0 1rem; }
  .g-btn {
    font-family: 'Quicksand', sans-serif;
    font-weight: 600; font-size: 0.95rem;
    padding: 0.65rem 2rem; border: none; border-radius: 999px;
    background: linear-gradient(135deg, var(--s-pink), var(--s-peach));
    color: #fff; cursor: pointer;
    box-shadow: 0 4px 16px rgba(232,120,138,0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .g-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(232,120,138,0.4);
  }
  .game-hud {
    position: absolute; top: 0; left: 0; right: 0;
    display: flex; justify-content: space-between;
    padding: 0.75rem 1rem;
    font-family: 'Quicksand', sans-serif;
    font-size: 0.95rem; font-weight: 600;
    color: var(--s-text);
    pointer-events: none;
  }

  /* ═══ TIMELINE ═══ */
  .tl {
    position: relative;
    max-width: 560px; margin: 0 auto;
    padding: 1rem 0 1rem 2.5rem;
  }
  .tl-line {
    position: absolute; left: 8px; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--s-pink-l), var(--s-peach-l));
    border-radius: 1px;
  }
  .tl-item { position: relative; margin-bottom: 2rem; }
  .tl-dot {
    position: absolute; left: -2.5rem; top: 1.1rem;
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--s-pink);
    border: 3px solid #FFF8F5;
    box-shadow: 0 0 0 2px var(--s-pink-l);
    z-index: 1;
  }
  .tl-card {
    background: var(--s-card);
    border: 1px solid var(--s-border);
    border-radius: 12px; padding: 1.25rem 1.5rem;
    box-shadow: 0 2px 12px rgba(139,107,115,0.06);
  }
  .tl-card time {
    font-size: 0.75rem; font-weight: 600;
    color: var(--s-pink); letter-spacing: 0.04em;
  }
  .tl-card h3 {
    font-family: 'Gowun Dodum', sans-serif;
    font-size: 1.05rem; margin: 0.3rem 0 0.25rem; color: var(--s-text);
  }
  .tl-card p {
    font-size: 0.85rem; color: var(--s-muted); line-height: 1.6;
    margin-bottom: 0.6rem;
  }
  .tl-card p:last-child {
    margin-bottom: 0;
  }
  .tl-card-last {
    border-style: dashed;
    background: linear-gradient(135deg, var(--s-pink-xl), var(--s-peach-l));
  }

  /* ═══ LETTER ═══ */
  .letter {
    max-width: 560px; margin: 3rem auto 0;
    background: linear-gradient(170deg, #FFFAF8, #FFF5F0);
    border: 1px solid var(--s-border);
    border-radius: 16px; padding: 2.5rem 2rem;
    position: relative; overflow: hidden;
    box-shadow:
      0 2px 12px rgba(139,107,115,0.06),
      inset 0 0 80px rgba(244,167,124,0.04);
  }
  .letter::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--s-pink), var(--s-peach), var(--s-gold));
    border-radius: 16px 16px 0 0;
  }
  .letter-seal {
    font-size: 2rem; text-align: center; margin-bottom: 1rem;
  }
  .letter-date {
    font-family: 'Caveat', cursive;
    font-size: 0.95rem; color: var(--s-muted);
    text-align: right; margin-bottom: 0.5rem;
  }
  .letter-to {
    font-family: 'Gowun Dodum', sans-serif;
    font-size: 1.15rem; color: var(--s-text); margin-bottom: 1rem;
  }
  .letter-body p {
    font-family: 'Caveat', cursive;
    font-size: 1.15rem; line-height: 1.8;
    color: var(--s-muted); margin-bottom: 0.6rem;
  }
  .letter-sign {
    font-family: 'Caveat', cursive;
    font-size: 1.2rem; color: var(--s-rose);
    margin-top: 1.5rem; text-align: right;
  }

  /* ═══ FOOTER ═══ */
  .sunny-footer {
    position: relative; z-index: 1;
    text-align: center; padding: 2rem 1rem 3rem;
    font-size: 0.85rem; color: var(--s-muted);
  }
  .footer-heart {
    display: inline-block; color: var(--s-pink);
    animation: heartBeat 1.2s ease-in-out infinite;
  }
  @keyframes heartBeat {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.25); }
    30% { transform: scale(1); }
    45% { transform: scale(1.15); }
    60% { transform: scale(1); }
  }

  /* ═══ REVEAL ANIMATION ═══ */
  .reveal {
    opacity: 0; transform: translateY(1.5rem);
    transition: opacity 0.6s cubic-bezier(.22,1,.36,1),
                transform 0.6s cubic-bezier(.22,1,.36,1);
    transition-delay: var(--d, 0ms);
  }
  .reveal.visible {
    opacity: 1; transform: translateY(0);
  }

  /* ═══ UTILITY ANIMATIONS ═══ */
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(1.2rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<!-- ═══════════════════════════════════════════════
     CLIENT-SIDE SCRIPTS
     ═══════════════════════════════════════════════ -->
<script>
  // ── Scroll reveal ──
  const revealObs = new IntersectionObserver(
    (entries) => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); revealObs.unobserve(e.target); }
    }),
    { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

  // ────────────────────────────────────────
  //  LIGHTBOX
  // ────────────────────────────────────────
  const photos: string[] = Array.from(document.querySelectorAll<HTMLImageElement>('.polaroid img')).map(i => i.src);
  let lbIdx = 0;
  const lb   = document.getElementById('lb')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCnt = document.getElementById('lb-count')!;

  function lbOpen(idx: number) {
    lbIdx = idx;
    lbImg.src = photos[idx];
    lbImg.alt = `Photo ${idx + 1} of ${photos.length}`;
    lbCnt.textContent = `${idx + 1} / ${photos.length}`;
    lb.classList.add('open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    (document.getElementById('lb-close') as HTMLElement).focus();
  }
  function lbClose() {
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }
  function lbNav(dir: number) {
    lbIdx = (lbIdx + dir + photos.length) % photos.length;
    lbImg.src = photos[lbIdx];
    lbCnt.textContent = `${lbIdx + 1} / ${photos.length}`;
  }

  document.querySelectorAll('.polaroid').forEach(el => {
    el.addEventListener('click', () => lbOpen(Number((el as HTMLElement).dataset.idx)));
  });
  document.getElementById('lb-close')!.addEventListener('click', lbClose);
  document.getElementById('lb-prev')!.addEventListener('click', () => lbNav(-1));
  document.getElementById('lb-next')!.addEventListener('click', () => lbNav(1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lbClose(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') lbClose();
    if (e.key === 'ArrowLeft') lbNav(-1);
    if (e.key === 'ArrowRight') lbNav(1);
  });

  // Touch swipe for lightbox
  let touchStartX = 0;
  lb.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) lbNav(dx < 0 ? 1 : -1);
  });

  // ────────────────────────────────────────
  //  CATCH-THE-HEARTS GAME
  // ────────────────────────────────────────
  const canvas = document.getElementById('gc') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const gov = document.getElementById('gov')!;
  const gStart = document.getElementById('g-start')!;
  const gEnd = document.getElementById('g-end')!;
  const gFinal = document.getElementById('g-final')!;
  const gHud = document.getElementById('g-hud')!;
  const gSc = document.getElementById('g-sc')!;
  const gTm = document.getElementById('g-tm')!;

  let dpr = window.devicePixelRatio || 1;
  let W: number, H: number;

  function resizeCanvas() {
    const rect = canvas.getBoundingClientRect();
    W = rect.width;
    H = rect.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  // Heart drawing
  function drawHeart(x: number, y: number, size: number, color: string) {
    ctx.save();
    ctx.fillStyle = color;
    ctx.beginPath();
    const s = size * 0.5;
    ctx.moveTo(x, y + s * 0.3);
    ctx.bezierCurveTo(x, y, x - s, y, x - s, y + s * 0.3);
    ctx.bezierCurveTo(x - s, y + s * 0.7, x, y + s, x, y + s * 1.2);
    ctx.bezierCurveTo(x, y + s, x + s, y + s * 0.7, x + s, y + s * 0.3);
    ctx.bezierCurveTo(x + s, y, x, y, x, y + s * 0.3);
    ctx.fill();
    ctx.restore();
  }

  // Basket
  const basket = { x: 0, w: 64, h: 14 };
  function drawBasket() {
    const bx = basket.x - basket.w / 2;
    const by = H - 40;
    ctx.save();
    ctx.fillStyle = '#B76E79';
    ctx.beginPath();
    ctx.roundRect(bx, by, basket.w, basket.h, 7);
    ctx.fill();
    ctx.fillStyle = '#a05d67';
    ctx.beginPath();
    ctx.roundRect(bx + 4, by + basket.h, basket.w - 8, 18, [0, 0, 8, 8]);
    ctx.fill();
    ctx.restore();
  }

  // Game state
  interface Heart { x: number; y: number; size: number; speed: number; color: string; golden: boolean; rot: number; rv: number; }
  interface Particle { x: number; y: number; vx: number; vy: number; life: number; color: string; size: number; }

  let hearts: Heart[] = [];
  let particles: Particle[] = [];
  let score = 0;
  let timer = 30;
  let playing = false;
  let frameCount = 0;
  let timerInterval: number;
  let rafId: number;

  const heartColors = ['#E8788A', '#FF6B8A', '#FF8FAB', '#F06292', '#F48FB1'];

  function spawnHeart() {
    const golden = Math.random() < 0.1;
    hearts.push({
      x: 20 + Math.random() * (W - 40),
      y: -30,
      size: 18 + Math.random() * 14,
      speed: 1.5 + Math.random() * 1.5 + score * 0.02,
      color: golden ? '#FFD700' : heartColors[Math.floor(Math.random() * heartColors.length)],
      golden,
      rot: (Math.random() - 0.5) * 0.6,
      rv: (Math.random() - 0.5) * 0.04,
    });
  }

  function spawnParticles(x: number, y: number, color: string) {
    for (let i = 0; i < 8; i++) {
      const angle = (Math.PI * 2 * i) / 8;
      particles.push({
        x, y,
        vx: Math.cos(angle) * (1.5 + Math.random() * 2),
        vy: Math.sin(angle) * (1.5 + Math.random() * 2),
        life: 1,
        color,
        size: 2 + Math.random() * 3,
      });
    }
  }

  function update() {
    frameCount++;
    // Spawn
    const rate = Math.max(20, 50 - score);
    if (frameCount % rate === 0) spawnHeart();

    // Move hearts
    for (let i = hearts.length - 1; i >= 0; i--) {
      const h = hearts[i];
      h.y += h.speed;
      h.rot += h.rv;

      // Catch check
      const by = H - 40;
      if (h.y + h.size * 0.5 >= by && h.y + h.size * 0.5 <= by + 32) {
        if (Math.abs(h.x - basket.x) < basket.w * 0.6) {
          score += h.golden ? 5 : 1;
          gSc.textContent = String(score);
          spawnParticles(h.x, h.y, h.color);
          hearts.splice(i, 1);
          continue;
        }
      }

      // Off screen
      if (h.y > H + 40) { hearts.splice(i, 1); }
    }

    // Move particles
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      p.vy += 0.08;
      p.life -= 0.025;
      if (p.life <= 0) particles.splice(i, 1);
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Draw hearts
    for (const h of hearts) {
      ctx.save();
      ctx.translate(h.x, h.y);
      ctx.rotate(h.rot);
      if (h.golden) {
        ctx.shadowColor = '#FFD700';
        ctx.shadowBlur = 12;
      }
      drawHeart(0, 0, h.size, h.color);
      ctx.restore();
    }

    // Draw particles
    for (const p of particles) {
      ctx.save();
      ctx.globalAlpha = p.life;
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    // Draw basket
    drawBasket();
  }

  function gameLoop() {
    if (!playing) return;
    update();
    draw();
    rafId = requestAnimationFrame(gameLoop);
  }

  function startGame() {
    score = 0; timer = 30; frameCount = 0;
    hearts = []; particles = [];
    basket.x = W / 2;
    gSc.textContent = '0';
    gTm.textContent = '30';

    gov.classList.add('hide');
    gHud.style.display = '';
    playing = true;

    timerInterval = window.setInterval(() => {
      timer--;
      gTm.textContent = String(timer);
      if (timer <= 0) endGame();
    }, 1000);

    gameLoop();
  }

  function endGame() {
    playing = false;
    cancelAnimationFrame(rafId);
    clearInterval(timerInterval);
    gHud.style.display = 'none';
    gStart.style.display = 'none';
    gEnd.style.display = '';
    gFinal.textContent = `You caught ${score} heart${score !== 1 ? 's' : ''}!`;
    gov.classList.remove('hide');
  }

  document.getElementById('g-go')!.addEventListener('click', startGame);
  document.getElementById('g-again')!.addEventListener('click', () => {
    gEnd.style.display = 'none';
    gStart.style.display = '';
    startGame();
  });

  // Controls
  canvas.addEventListener('mousemove', (e) => {
    if (!playing) return;
    const rect = canvas.getBoundingClientRect();
    basket.x = Math.max(basket.w / 2, Math.min(W - basket.w / 2, e.clientX - rect.left));
  });
  canvas.addEventListener('touchmove', (e) => {
    if (!playing) return;
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    basket.x = Math.max(basket.w / 2, Math.min(W - basket.w / 2, e.touches[0].clientX - rect.left));
  }, { passive: false });
</script>
