---
import "../styles/global.css";

// Import all images from the sunny folder
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../sunny/*.{jpg,jpeg,JPG,JPEG,png,PNG}',
  { eager: true }
);

// Filter duplicates and extract sources
const photos = Object.entries(imageModules)
  .filter(([path]) => {
    const filename = path.split('/').pop() || '';
    // Skip duplicate copies
    if (/ 2\./.test(filename)) return false;
    if (/ 2 /.test(filename)) return false;
    if (/\(\d+\)/.test(filename)) return false;
    return true;
  })
  .map(([_, mod]) => mod.default.src);

// Shuffle photos for a scattered-on-table feel
const shuffled = [...photos].sort(() => 0.5 - Math.random());

// Pre-generate random rotations for polaroids
const rotations = shuffled.map((_, i) => ((i * 7 + 3) % 11 - 5) * 0.7);

// Floating hearts config
const floatingHearts = Array.from({ length: 18 }, (_, i) => ({
  left: (i * 17 + 5) % 100,
  size: 10 + (i * 7) % 18,
  dur: 10 + (i * 3) % 14,
  delay: (i * 1.7) % 12,
  opacity: 0.04 + (i % 5) * 0.02,
}));
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>&#xB0B4; &#xC0AC;&#xB791; &#xC120;&#xC774;&#xC5D0;&#xAC8C; &#x1F90D;</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Gowun+Dodum&family=Quicksand:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="sunny-page" style="background:#FFF8F5;color:#3D2024;font-family:'Quicksand',sans-serif;">
    <!-- ═══════════ FLOATING HEARTS ═══════════ -->
    <div class="floating-hearts-container" aria-hidden="true">
      {floatingHearts.map((h) => (
        <span
          class="fh"
          style={`left:${h.left}%;font-size:${h.size}px;animation-duration:${h.dur}s;animation-delay:${h.delay}s;opacity:${h.opacity};`}
        >&hearts;</span>
      ))}
    </div>

    <!-- ═══════════ HERO ═══════════ -->
    <section class="sunny-hero">
      <div class="hero-inner">
        <p class="hero-whisper">a little corner of the internet, just for you</p>
        <h1 class="hero-title">
          <span class="title-line">&shy;&#xB0B4; &#xC0AC;&#xB791;</span>
          <span class="title-line accent">&#xC120;&#xC774;&#xC5D0;&#xAC8C;</span>
        </h1>
        <div class="hero-heart-pulse">&hearts;</div>
        <p class="hero-sub">Every moment with you is my favourite memory</p>
      </div>
      <div class="scroll-hint" aria-hidden="true">
        <span>scroll</span>
        <svg width="20" height="28" viewBox="0 0 20 28" fill="none">
          <rect x="1" y="1" width="18" height="26" rx="9" stroke="currentColor" stroke-width="1.5"/>
          <circle class="scroll-dot" cx="10" cy="8" r="2" fill="currentColor"/>
        </svg>
      </div>
    </section>

    <!-- ═══════════ GALLERY ═══════════ -->
    <section class="sunny-section" id="gallery">
      <div class="sec-head">
        <span class="sec-tag">&shy;&#xC6B0;&#xB9AC;&#xC758; &#xCD94;&#xC5B5;</span>
        <h2 class="sec-title">Our Moments</h2>
      </div>

      <div class="masonry">
        {shuffled.map((src, i) => (
          <button
            class="polaroid reveal"
            style={`--rot:${rotations[i]}deg;--d:${(i % 8) * 60}ms`}
            data-idx={i}
            type="button"
            aria-label="Open photo"
          >
            <img src={src} loading="lazy" decoding="async" alt="" />
          </button>
        ))}
      </div>
    </section>

    <!-- ═══════════ LIGHTBOX ═══════════ -->
    <div class="lb" id="lb" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Photo viewer">
      <button class="lb-close" id="lb-close" aria-label="Close">&times;</button>
      <button class="lb-arr lb-prev" id="lb-prev" aria-label="Previous photo">&lsaquo;</button>
      <button class="lb-arr lb-next" id="lb-next" aria-label="Next photo">&rsaquo;</button>
      <img class="lb-img" id="lb-img" src="" alt="Photo" />
      <span class="lb-count" id="lb-count"></span>
    </div>

    <!-- ═══════════ CATCH THE HEARTS GAME ═══════════ -->
    <section class="sunny-section" id="game-section">
      <div class="sec-head">
        <span class="sec-tag">&shy;&#xBBF8;&#xB2C8; &#xAC8C;&#xC784;</span>
        <h2 class="sec-title">Catch the Hearts</h2>
        <p class="sec-desc">Swipe to move the basket &mdash; catch as many hearts as you can!</p>
      </div>

      <div class="game-wrap">
        <canvas id="gc"></canvas>

        <div class="game-overlay" id="gov">
          <!-- Start screen -->
          <div id="g-start">
            <div class="g-icon">&hearts;</div>
            <p class="g-label">Catch falling hearts!</p>
            <p class="g-sub">30 seconds &middot; golden hearts = 5 pts</p>
            <button class="g-btn" id="g-go">Start Game</button>
          </div>
          <!-- Game-over screen -->
          <div id="g-end" style="display:none;">
            <div class="g-icon">&#x1F389;</div>
            <p class="g-label" id="g-final"></p>
            <button class="g-btn" id="g-again">Play Again</button>
          </div>
        </div>

        <div class="game-hud" id="g-hud" style="display:none;">
          <span>&hearts; <b id="g-sc">0</b></span>
          <span>&#x23F1; <b id="g-tm">30</b>s</span>
        </div>
      </div>
    </section>

    <!-- ═══════════ TIMELINE & LETTER ═══════════ -->
    <section class="sunny-section" id="story">
      <div class="sec-head">
        <span class="sec-tag">&shy;&#xC6B0;&#xB9AC;&#xC758; &#xC774;&#xC57C;&#xAE30;</span>
        <h2 class="sec-title">Our Story</h2>
      </div>

      <div class="tl">
        <div class="tl-line" aria-hidden="true"></div>

        <div class="tl-item reveal">
          <div class="tl-dot"></div>
          <div class="tl-card">
            <time>2025. 06. 20</time>
            <h3>우리가 처음 만난 날</h3>
            <p>우리 원래 토요일에 처음 만나기로 했었잖아. 근데 자기가 금요일에 시간 된다고 만나자고 해서 정말 놀랍고 설렜어. 그날 회사에서 자기 생각에 일이 도통 손에 안 잡히더라… 6:00… 6:30… 6:50… 퇴근시간이 가까워질수록 심장이 점점 빨리 뛰기 시작했어.</p>
            <p>커피빈에서 기다린다는 문자를 받고, 7시 땡 하자마자 바로 뛰어갔지. 거기 앉아 있는 가장 예쁜 사람한테 말을 걸었어. 자기였어.</p>
            <p>인사하고 자기가 나한테 선물을 건네줬는데, 그림도 그려주고 노트도 줘서 너무 감동이었어 ㅎㅎ. 그날 고메램에서 같이 양고기를 먹었는데, 자기가 가 본 식당 중에서 가장 맛있다고 해줘서 그 말이 그렇게 고마울 수가 없었어.</p>
            <p>밥을 먹고 버스 정류장에서 헤어졌지. 내가 조심히 들어가라고 하고, "ㅅㄹㅎ" 이렇게 보냈잖아. 그리고 자기가 먼저 사귀자고 했고. 그 순간이 내가 살면서 가장 설레고 행복했던 순간이야.</p>
            <p>고마워, 내 삶에 나타나줘서. 선이야 ☀️</p>
          </div>
        </div>

        <div class="tl-item reveal">
          <div class="tl-dot"></div>
          <div class="tl-card">
            <time>2025. 08. 08</time>
            <h3>우리 50일</h3>
            <p>벌써 50일이라니. 매일 자기가 보고 싶고, 매일 자기 목소리가 듣고 싶고, 매일이 설렜어. 자기랑 함께 보내는 하루하루가 이렇게 소중할 수 있다는 걸 처음 알았어.</p>
            <p>나에게 50일은 너무 특별했어. 여자한테 처음 꽃을 받은 날이었거든! 자기랑 이날도 어김없이 회사 끝나고 만났는데, 그동안 함께 보내온 시간이 50일보다 훨씬 길게 느껴졌어.</p>
            <p>원래 가고 싶었던 tbd는 못 갔지만, 대신 간 라페름도 맛있어서 충분히 좋았어. 그리고 자기가 처음 술을 마셨는데 얼굴이 금방 빨개져서 너무 귀여웠어!</p>
            <p>밥 먹고 한남동을 산책하고, 인생네컷 찍으러 갔잖아. 그날 한 2~3번은 찍었던 걸로 기억해 ㅋㅋㅋ 처음 하루필름은 취한 사람들처럼 나왔고, 나중에 찍은 포토그레이는 진짜 너무 예뻤어! (한때 내 핸드폰 배경이었음 ㅎㅎ)</p>
          </div>
        </div>

        <div class="tl-item reveal">
          <div class="tl-dot"></div>
          <div class="tl-card">
            <time>2025. 09. 27</time>
            <h3>우리 100일</h3>
            <p>우리 100일을 대전에서 보냈잖아… 내가 너무 아파서 서울로 못 올라가서 미안해. 그런데도 자기가 대전까지 내려와줘서 정말 고맙고 감동이었어.</p>
            <p>화려한 식당이나 특별한 경험을 못 해줘서 마음이 좀 아팠지만, 그래도 자기랑 한 침대에 나란히 누워서 같이 숨 쉬고, 자기가 나 간호해주던 그 시간이 솔직히 너무 좋았어.</p>
            <p>앞으로 이런 시간이 더 자주 있으면 좋겠다! (아픈 거 말고 같이 누워있는 거 ㅎㅎ)</p>
          </div>
        </div>

        <div class="tl-item reveal">
          <div class="tl-dot"></div>
          <div class="tl-card">
            <time>2026. 01. 05</time>
            <h3>우리 200일</h3>
            <p>200일은 다행히 내가 안 아팠어! 일이 끝나고 강남역에서 만나기로 했는데 늦어서 미안해… 그리고 자기를 내가 있는 데까지 오라고 해서 미안해. 편하지 않은 신발에, 무거운 가방이랑 수제 케이크까지 들고 오게 했잖아. 너무 무책임했어, 다음엔 내가 뛰어갈게.</p>
            <p>그래도 식당 가서 맛있는 거 먹인 것 같아서 기분이 좋았어. 밥 다 먹고 케이크를 열었는데, 내가 살면서 본 케이크 중에 가장 예뻤어!! 당연히 맛도 있었고. 남은 건 집에 가서 가족들이랑 나눠 먹으면서 자기 자랑 많이 했어 ㅎㅎ.</p>
            <p>이날 나는 자기한테 꽃 줬는데, 자기 엄마가 좋아하셔서 기뻤어!! 앞으로 꽃 선물 더 자주 할 거니까 기대해줘 ㅎㅎ. 그리고 이날 찍은 인생네컷 완전 마음에 들어!! 지금 내 배경이고, 한동안은 안 바뀔 것 같아.</p>
            <p>자기랑 300일, 1000일, 그리고 10000일까지 함께하고 싶어 ☀️</p>
          </div>
        </div>

        <div class="tl-item reveal">
          <div class="tl-dot"></div>
          <div class="tl-card tl-card-last">
            <time>앞으로도 쭉...</time>
            <h3>그리고 앞으로도 함께</h3>
            <p>And many more memories to come &hearts;</p>
          </div>
        </div>
      </div>

      <!-- Personal letter -->
      <div class="letter reveal">
        <div class="letter-seal">&#x1F48C;</div>
        <p class="letter-date">2026. 02. 07</p>
        <p class="letter-to">선이에게,</p>
        <div class="letter-body">
          <p>솔직히 이 편지를 쓸 수 있다는 게 아직도 믿기지 않아.</p>
          <p>며칠 전, 나는 진짜로 널 보내려고 했어. 회사에서 야근하고 자정이 넘어서 전화했잖아. 그 전화 속에서 나는 내 솔직한 마음을 다 꺼냈어. 내가 너무 바쁘고, 일에 치여서 자기한테 계속 소홀해지는 게 보였어. 그리고 그걸 기다려주고, 이해하려고 애쓰다가 지쳐가는 자기 모습도 보였어. 그게 너무 미안했어. 자기한테 평생 함께하자는 약속을 해주면 되는 건데, 아직 1년도 안 된 우리한테 그 약속은 너무 무겁다고 느꼈어. 내 가치관이 그랬어. 그래서 차라리 놓아주는 게 맞다고 생각했어.</p>
          <p>근데 전화로 끝내면 안 될 것 같았어. 자기 얼굴을 보고 마무리해야 된다고 생각했어. 그래서 회사에서 나와서 바로 동탄행 택시를 탔어.</p>
          <p>택시 안에서 나는 아무 생각이 안 났어. 창밖만 멍하게 봤어. 이게 맞나. 이게 정말 맞나. 계속 그 생각만 맴돌았어.</p>
          <p>그리고 자기가 나와줬어.</p>
          <p>자기 얼굴을 보는 순간, 내 안에서 뭔가 와르르 무너졌어. 그렇게 단단하게 다짐하고 갔는데, 자기 앞에 서니까 아무것도 아니었어. 헤어지겠다는 말이 입에서 안 나왔어. 나오면 안 됐어. 이 사람을 내가 왜 놓으려고 했지. 이 사람 없이 내가 어떻게 살지.</p>
          <p>우리 그날 서로 안고 많이 울었잖아.</p>
          <p>그 눈물 속에서 나는 깨달았어. 완벽한 약속을 못 해서 미안한 게 아니라, 이 사람을 지키려는 노력을 더 해야 하는 거였어. 평생이라는 말을 지금 못 하더라도, 오늘 하루, 내일 하루, 자기를 더 소중히 대하는 것부터 시작하면 되는 거였어.</p>
          <p>우리 다시 잘 해보자고 했잖아. 그 말, 나는 진심이야.</p>
          <p>앞으로 자기가 기다리다 지치지 않게, 내가 더 잘할게. 바쁘다는 말 뒤에 숨지 않을게. 최대한 내 시간 될 때 자기한테 먼저 연락하고, 먼저 보고 싶다고 말할게. 완벽하진 못해도, 어제보다 자기한테 더 나은 사람이 되고 싶어.</p>
        </div>
        <p class="letter-sign">사랑해,<br/>준하오빠가</p>
      </div>
    </section>

    <!-- ═══════════ FOOTER ═══════════ -->
    <footer class="sunny-footer">
      <p>Made with <span class="footer-heart">&hearts;</span> just for you, &#xC120;&#xC774;&#xC57C;</p>
    </footer>
  </body>
</html>

<!-- ═══════════════════════════════════════════════
     STYLES
     ═══════════════════════════════════════════════ -->
<style is:global>
  /* ── Reset overrides for this page ── */
  body.sunny-page {
    background: #FFF8F5 !important;
    color: #3D2024 !important;
    font-family: 'Quicksand', sans-serif !important;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }
  body.sunny-page::after { display: none !important; }          /* kill grain */
  body.sunny-page ::selection { background: #E8788A; color: #fff; }

  /* ── Palette variables ── */
  :root {
    --s-pink: #E8788A;
    --s-pink-l: #FFD4DC;
    --s-pink-xl: #FFF0F3;
    --s-peach: #F4A77C;
    --s-peach-l: #FFE8D6;
    --s-rose: #B76E79;
    --s-gold: #D4A574;
    --s-text: #3D2024;
    --s-muted: #6B4B53;
    --s-card: rgba(255,255,255,0.85);
    --s-border: rgba(232,120,138,0.15);
  }

  /* ═══ FLOATING HEARTS ═══ */
  .floating-hearts-container {
    position: fixed; inset: 0;
    pointer-events: none; z-index: 0; overflow: hidden;
  }
  .fh {
    position: absolute; bottom: -30px;
    color: var(--s-pink);
    animation: fhFloat linear infinite;
  }
  @keyframes fhFloat {
    0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 1; }
    100% { transform: translateY(-110vh) rotate(25deg); opacity: 0; }
  }

  /* ═══ HERO ═══ */
  .sunny-hero {
    position: relative; z-index: 1;
    min-height: 100svh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(255,212,220,0.5) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 30%, rgba(255,232,214,0.5) 0%, transparent 60%),
      radial-gradient(ellipse at 50% 80%, rgba(244,167,124,0.15) 0%, transparent 50%),
      linear-gradient(160deg, #FFF0F3, #FFF8F5 40%, #FFECD2 100%);
    background-size: 200% 200%, 200% 200%, 100% 100%, 100% 100%;
    animation: heroGrad 20s ease infinite;
  }
  @keyframes heroGrad {
    0%, 100% { background-position: 0% 50%, 100% 0%, 0% 0%, 0% 0%; }
    33%      { background-position: 100% 0%, 0% 100%, 0% 0%, 0% 0%; }
    66%      { background-position: 50% 100%, 50% 0%, 0% 0%, 0% 0%; }
  }

  .hero-inner { max-width: 600px; }

  .hero-whisper {
    font-size: 0.8rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--s-muted); margin-bottom: 1.5rem;
    opacity: 0; animation: fadeSlideUp 0.8s 0.3s ease forwards;
  }

  .hero-title {
    font-family: 'Gowun Dodum', 'Quicksand', sans-serif;
    font-size: clamp(2.2rem, 8vw, 4rem);
    font-weight: 400; line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  .title-line {
    display: block;
    opacity: 0; animation: fadeSlideUp 0.8s ease forwards;
  }
  .title-line:nth-child(1) { animation-delay: 0.5s; }
  .title-line.accent {
    color: var(--s-pink);
    animation-delay: 0.8s;
  }

  .hero-heart-pulse {
    font-size: 2rem; margin: 1rem 0;
    color: var(--s-pink);
    opacity: 0; animation: fadeSlideUp 0.6s 1.1s ease forwards;
  }
  .hero-heart-pulse::after { content: ''; }

  .hero-sub {
    font-family: 'Caveat', cursive;
    font-size: clamp(1.1rem, 4vw, 1.5rem);
    color: var(--s-muted); font-weight: 500;
    opacity: 0; animation: fadeSlideUp 0.7s 1.3s ease forwards;
  }

  /* Scroll hint */
  .scroll-hint {
    position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem;
    color: var(--s-muted); font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
    opacity: 0; animation: fadeSlideUp 0.5s 1.8s ease forwards;
  }
  .scroll-dot { animation: scrollBounce 2s ease-in-out infinite; }
  @keyframes scrollBounce {
    0%, 100% { cy: 8; opacity: 1; }
    50%      { cy: 20; opacity: 0.3; }
  }

  /* ═══ SHARED SECTION ═══ */
  .sunny-section {
    position: relative; z-index: 1;
    max-width: 1100px; margin: 0 auto;
    padding: 4rem 1.25rem;
  }
  .sec-head { text-align: center; margin-bottom: 2.5rem; }
  .sec-tag {
    display: inline-block;
    font-family: 'Gowun Dodum', sans-serif;
    font-size: 0.75rem; letter-spacing: 0.1em;
    color: var(--s-pink); background: var(--s-pink-xl);
    padding: 0.25rem 0.9rem; border-radius: 999px;
    margin-bottom: 0.6rem;
  }
  .sec-title {
    font-family: 'Quicksand', sans-serif;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 700; color: var(--s-text);
  }
  .sec-desc {
    font-size: 0.9rem; color: var(--s-muted); margin-top: 0.4rem;
